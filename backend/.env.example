# Matches docker-compose.dev.yml (local dev Postgres). Production settings live in
# .env.production.example at the repository root.
DATABASE_URL="postgresql://pocketmoney:pocketmoney@localhost:5432/pocketmoney"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
CLIENT_URL="http://localhost:5173"
# Fuseau du calendrier des corvées récurrentes et de l'argent de poche (défaut : Europe/Paris).
# APP_TIMEZONE=Europe/Paris
# Nombre de reverse proxys devant l'API (défaut : 1 en production, 0 sinon).
# Le rate limiting s'en sert pour retrouver la vraie IP du client.
# TRUST_PROXY_HOPS=1
# Politique SameSite du cookie de session (lax par défaut). Garder lax si le front
# et l'API partagent le même site (même domaine ou sous-domaines). Mettre none
# seulement sur des sites différents, avec un CLIENT_URL en https ; certains
# navigateurs bloquent quand même ces cookies tiers.
# COOKIE_SAMESITE=lax
# Bouton « Essayer la démo » : une famille jetable par visiteur, supprimée après 24 h.
# DEMO_ENABLED=true
