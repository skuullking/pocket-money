# Matches docker-compose.dev.yml (local dev Postgres). For production use the
# postgresql:// URL wired in docker-compose.yml.
DATABASE_URL="postgresql://pocketmoney:pocketmoney@localhost:5432/pocketmoney"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
CLIENT_URL="http://localhost:5173"
# Nombre de reverse proxys devant l'API (défaut : 1 en production, 0 sinon).
# Le rate limiting s'en sert pour retrouver la vraie IP du client.
# TRUST_PROXY_HOPS=1
