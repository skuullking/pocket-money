# URL de base de l'API, lue par Vite au moment du build (src/api.js).
# Le temps réel (Socket.IO) se connecte à la même origine, sans le suffixe /api.
#
# Dev local : copier ce fichier vers .env (ou ne rien définir, c'est le défaut).
VITE_API_URL=http://localhost:3001/api

# Production :
#   - Docker / nginx : /api (même origine, nginx proxifie vers le backend).
#     C'est la valeur de .env.production.
#   - API sur un autre domaine (ex. Vercel) : définir la variable sur la plateforme,
#     elle a priorité sur .env.production.
#     VITE_API_URL=https://api.example.com/api
