# Copier vers .env (non versionné) à côté de docker-compose.yml, puis remplir.
# docker compose refuse de démarrer tant qu'une valeur requise manque.

# Générer chaque secret avec : openssl rand -hex 32
# (hexadécimal : le mot de passe est aussi inséré dans DATABASE_URL.)
POSTGRES_PASSWORD=
JWT_SECRET=

# Origine exacte du site, sans slash final (CORS, cookies, liens des emails).
CLIENT_URL=https://pocketmoney.example.com
