# Copier vers .env (non versionné) à côté de docker-compose.yml, puis remplir.
# docker compose refuse de démarrer tant qu'une valeur requise manque.

# Générer chaque secret avec : openssl rand -hex 32
# (hexadécimal : le mot de passe est aussi inséré dans DATABASE_URL.)
POSTGRES_PASSWORD=
JWT_SECRET=

# Nom de domaine public, sans https://. Son enregistrement DNS A/AAAA doit pointer
# vers ce serveur, ports 80 et 443 ouverts, pour obtenir le certificat.
DOMAIN=pocketmoney.example.com

# Clé API Resend et expéditeur sur un domaine vérifié dans Resend.
RESEND_API_KEY=
EMAIL_FROM=PocketMoney <no-reply@pocketmoney.example.com>

# Affichés dans la politique de confidentialité et les CGU.
LEGAL_OPERATOR=Nom ou raison sociale, adresse
LEGAL_CONTACT=contact@pocketmoney.example.com
LEGAL_HOST=Nom de l'hébergeur, adresse

# Optionnel : suivi d'erreurs Sentry, un projet pour l'API, un pour le navigateur.
SENTRY_DSN=
SENTRY_DSN_FRONTEND=
